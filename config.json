{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.8.json",
	"author": "Dorios Studios",
	"name": "Dorios’ Builder Wands",
	"packs": {
		"behaviorPack": "./packs/BP",
		"resourcePack": "./packs/RP"
	},
	"regolith": {
		"dataPath": "./packs/data",
		"filterDefinitions": {
			"minify_bundle_scripts": {
				"runWith": "shell",
				"command": "npx esbuild BP/scripts/main.js --outfile=BP/scripts/__bundle.js --bundle --format=esm --target=es2020 --minify --legal-comments=none --log-level=warning --external:@minecraft/server --external:@minecraft/server-ui --external:@minecraft/server-* --external:@minecraft/common --external:@minecraft/debug-utilities --preserve-symlinks"
			},
			"use_bundle_entry": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('fs'); const p='BP/manifest.json'; const m=JSON.parse(fs.readFileSync(p,'utf8')); const script=m.modules.find(module=>module.type==='script'); if(script) script.entry='scripts/__bundle.js'; fs.writeFileSync(p, JSON.stringify(m,null,'\\t'));\""
			},
			"cleanup_bundled_scripts": {
				"runWith": "shell",
				"command": "node -e \"const fs=require('fs'); fs.renameSync('BP/scripts/__bundle.js','BP/__bundle.js'); fs.rmSync('BP/scripts',{recursive:true,force:true}); fs.mkdirSync('BP/scripts',{recursive:true}); fs.renameSync('BP/__bundle.js','BP/scripts/__bundle.js');\""
			}
		},
		"formatVersion": "1.8.0",
		"profiles": {
			"default": {
				"export": {
					"build": "standard",
					"readOnly": false,
					"target": "development"
				},
				"filters": []
			},
			"buildDev": {
				"export": {
					"bpName": "project.name + ' BP'",
					"rpName": "project.name + ' RP'",
					"target": "local"
				},
				"filters": []
			},
			"buildMinify": {
				"export": {
					"bpName": "project.name + ' BP'",
					"rpName": "project.name + ' RP'",
					"target": "local"
				},
				"filters": [
					{
						"filter": "minify_bundle_scripts"
					},
					{
						"filter": "use_bundle_entry"
					},
					{
						"filter": "cleanup_bundled_scripts"
					}
				]
			}
		}
	}
}
